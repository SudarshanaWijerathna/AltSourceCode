# Copy to .env and fill in. Never commit .env.

# Business date. Seed eval expectations assume 2026-11-19.
MIRA_TODAY=2026-11-19

# LLM provider (any; Anthropic shown as default)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MIRA_MODEL_LARGE=claude-sonnet-5-5
MIRA_MODEL_SMALL=claude-haiku-5-5

# Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Storage
MIRA_DB_URL=sqlite:///./data/mira.db

# Backend URL used by the frontend's CopilotKit runtime
MIRA_BACKEND_URL=http://localhost:8000
