# Copy to .env and fill in. Never commit .env.

# Business date. Seed eval expectations assume 2026-11-19.
MIRA_TODAY=2026-11-19

# LLM provider (any; Google shown as default)
LLM_PROVIDER="google"
GEMINI_API_KEY=
MIRA_MODEL_LARGE="gemini-3.8-flash"
MIRA_MODEL_SMALL="gemini-3.5-flash-lite"

# Tracing (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"   # EU; US is https://us.cloud.langfuse.com

# Storage
MIRA_DB_URL=sqlite:///./data/mira.db

# Backend URL used by the frontend's CopilotKit runtime
MIRA_BACKEND_URL=http://localhost:8000
